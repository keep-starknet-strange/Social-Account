# Copy to .env.local and fill in. Secrets only; .env.local is gitignored.
# Registry addresses live in .env (committed), keyed per chain, written by `bun run deploy:registry`.
RPC_URL=https://...
# Sent as the X-Starkscan-Api-Key header. Leave empty for any other RPC provider.
RPC_API_KEY=
# Deploys the registry, owns it, and pays for key rotations. Needs STRK.
OWNER_ADDRESS=0x...
OWNER_PRIVATE_KEY=0x...

# Recover API (bun run service:api)
PORT=3000
# Deploys social accounts through the UDC and relays prove_jwt (onchain mode) and recover. Needs STRK. Not the owner.
RELAYER_ADDRESS=0x...
RELAYER_PRIVATE_KEY=0x...
# local:   prove_jwt runs in the SNIP-36 prover and recover carries the proof.
# onchain: prove_jwt runs as a real transaction and recover carries no proof. POC only, see services/recovery/recover.ts.
PROVER_MODE=local
PROVER_URL=http://localhost:9900
# Sender of the virtual prove_jwt transaction (local mode). Not a security boundary, but keep the key private so nobody
# can take the account over or bump its nonce. Never fund it.
PROVER_ACCOUNT_ADDRESS=0x...
PROVER_ACCOUNT_PRIVATE_KEY=0x...

# Also read from .env (committed): AUTHORIZED_GOOGLE_RECOVERY_CLIENT_ID, AUTHORIZED_APPLE_RECOVERY_CLIENT_ID, SOCIAL_ACCOUNT_CLASS_HASH, <CHAIN>_REGISTRY_ADDRESS
