# Copy to .env.local and fill in. Secrets only; .env.local is gitignored.
# Registry addresses live in .env (committed), keyed per chain, written by `bun run deploy:registry`.
RPC_URL=https://...
# Sent as the X-Starkscan-Api-Key header. Leave empty for any other RPC provider.
RPC_API_KEY=
# Deploys the registry, owns it, and pays for key rotations. Needs STRK.
OWNER_ADDRESS=0x...
OWNER_PRIVATE_KEY=0x...

# Recover API (bun run service:api)
PORT=3000
# Deploys social accounts through the UDC and relays recover. Needs STRK. Not the owner.
RELAYER_ADDRESS=0x...
RELAYER_PRIVATE_KEY=0x...
# The SNIP-36 prover that runs prove_jwt; recover carries its proof.
PROVER_URL=http://localhost:9900
# Sender of the virtual prove_jwt transaction. Not a security boundary, but keep the key private so nobody
# can take the account over or bump its nonce. Never fund it.
PROVER_ACCOUNT_ADDRESS=0x...
PROVER_ACCOUNT_PRIVATE_KEY=0x...

# OAuth client ids `bun run deploy:registry` seeds as recovery auds. Same values as the client's VITE_*_CLIENT_ID.
AUTHORIZED_GOOGLE_RECOVERY_CLIENT_ID=
AUTHORIZED_APPLE_RECOVERY_CLIENT_ID=

# Also read from .env (committed): SOCIAL_ACCOUNT_CLASS_HASH, PROVER_EXECUTOR_ADDRESS, <CHAIN>_REGISTRY_ADDRESS

# The rotator answers GET /health on ROTATOR_PORT; the api proxies it from ROTATOR_URL as /health/rotator.
ROTATOR_PORT=3001
ROTATOR_URL=http://localhost:3001

# Cap on relayer-paid social account deployments through POST /deploy. 0 disables the route (local-proving first logins then need the client deploy hook).
DEPLOYS_PER_HOUR=30
