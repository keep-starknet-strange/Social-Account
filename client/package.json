{
  "name": "social-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tunnel": "ngrok http 5173 --url \"$TUNNEL_URL\"",
    "client:up": "trap 'kill 0' INT TERM; bun run dev & bun run tunnel & wait",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "local:prover:get": "bun run scripts/get-local-prover-assets.ts"
  },
  "dependencies": {
    "@scure/starknet": "^1.1.0",
    "garaga": "1.1.0",
    "preact": "^10",
    "starknet": "^10.5.0",
    "starkzap": "4.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "prettier": "^3.3.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}