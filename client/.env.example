# Copy to .env.local and fill in. .env.local is gitignored.
# Client IDs, the API URL and the account class hash live in .env (committed).
VITE_RPC_URL=https://...
# Local proving. A node that serves starknet_getStorageProof and starknet_getCompiledCasm with CORS for the
# browser prover's state reads; it only hands out storage proofs for recent blocks. The browser prover demo's
# public endpoint works on Sepolia. Leave empty to use VITE_RPC_URL (Alchemy support unverified).
VITE_PROVER_RPC_URL=https://api.zan.top/public/starknet-sepolia/rpc/v0_10
# Where client/public/prover/ is served from, if not this origin. Leave empty for /prover/.
VITE_PROVER_ASSETS_URL=
# Static https domain for `bun run tunnel` / `bun run client:up`. Apple only redirects to https on a registered
# domain, so register this host and https://<host>/callback on the Services ID and open the app through it.
TUNNEL_URL=https://<your-static-domain>.ngrok-free.dev
